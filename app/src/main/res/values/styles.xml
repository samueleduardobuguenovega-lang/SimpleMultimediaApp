<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Forma.Imagen" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radio_imagen</item>
    </style>

    <style name="Forma.Tarjeta" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radio_tarjeta</item>
    </style>

    <style name="Texto.Etiqueta" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/acento</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
    </style>

    <style name="Texto.Titulo" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/texto_primario</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texto.Cuerpo" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
